{
  "name": "@duke-dsh-plugins/dsh-deveco",
  "version": "0.1.0",
  "description": "DSH 正式 bundle 插件：在 better-sidebar 注册「HarmonyOS Suite」单实例 Tab，提供 HiLog 实时流、ArkUI Inspector（截图 + UI 树 + 交互）、ArkTS 项目浏览与 .ets 文件查看器；设置页管理 DevEco Studio / HarmonyOS Command Line Tools 路径（含三平台自发现、两者互斥、CLT 最低 26.0.0 校验；若 PATH 存在 devecocli 则优先使用，忽略设置路径）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "typert.host.js",
    "harmony-studio.mjs",
    "harmony-device.mjs",
    "harmony-config.mjs",
    "cordis.patch.yml",
    "scripts/self-test.mjs"
  ],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonlitDropOfBlood/dsh-deveco.git"
  },
  "homepage": "https://github.com/MoonlitDropOfBlood/dsh-deveco",
  "bugs": { "url": "https://github.com/MoonlitDropOfBlood/dsh-deveco/issues" },
  "keywords": ["dsh", "deepseek-harness", "plugin", "harmonyos", "arkts", "deveco", "hilog", "arkui"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "external": [
        "dsh-better-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/cordis": "4.0.1",
      "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
      "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.7"
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check typert.host.js && node --check harmony-studio.mjs && node --check harmony-device.mjs && node --check harmony-config.mjs && node --check scripts/self-test.mjs",
    "test": "node --test scripts/self-test.mjs --test-isolation=none"
  }
}